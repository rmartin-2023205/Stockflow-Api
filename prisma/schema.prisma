// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  CASHIER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  SALE_REVERSAL
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  memberships     Membership[]
  sales           Sale[]          @relation("CashierSales")
  cancelledSales  Sale[]          @relation("CancelledSales")
  stockMovements  StockMovement[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  currency  String   @default("GTQ")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships    Membership[]
  categories     Category[]
  products       Product[]
  sales          Sale[]
  stockMovements StockMovement[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(CASHIER)
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Category {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("categories")
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  categoryId     String?
  sku            String
  name           String
  description    String?
  costPrice      Decimal      @db.Decimal(12, 2)
  salePrice      Decimal      @db.Decimal(12, 2)
  stockQuantity  Int          @default(0)
  minStock       Int          @default(5)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems    SaleItem[]
  stockMovements StockMovement[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, sku])
  @@index([categoryId])
  @@map("products")
}

model Sale {
  id                 String       @id @default(cuid())
  organizationId     String
  cashierId          String
  saleNumber         String
  subtotal           Decimal      @db.Decimal(12, 2)
  discountTotal      Decimal      @default(0.00) @db.Decimal(12, 2)
  total              Decimal      @db.Decimal(12, 2)
  paymentMethod      String       @default("CASH")
  status             SaleStatus   @default(COMPLETED)
  cancelledById      String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime     @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cashier      User            @relation("CashierSales", fields: [cashierId], references: [id])
  cancelledBy  User?           @relation("CancelledSales", fields: [cancelledById], references: [id])
  items        SaleItem[]
  movements    StockMovement[]

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@map("sales")
}

model SaleItem {
  id                  String   @id @default(cuid())
  saleId              String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  quantity            Int
  unitPrice           Decimal  @db.Decimal(12, 2)
  unitCostSnapshot    Decimal  @db.Decimal(12, 2)
  lineTotal           Decimal  @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  userId         String
  type           MovementType
  quantity       Int
  stockBefore    Int
  stockAfter     Int
  reason         String?
  saleId         String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
